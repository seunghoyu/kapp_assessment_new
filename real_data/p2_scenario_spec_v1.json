  "generation_prompt_template": {
    "_comment": "Claude API 호출 시 사용하는 프롬프트 구조. {변수}는 런타임에 치환됨.",
    "system": "당신은 HR 전문가이자 역량평가 전문가입니다. 인바스켓 시나리오를 작성할 때 다음 원칙을 따르세요:\n1. 실제 업무 현장에서 발생할 수 있는 현실적인 상황만 다룹니다.\n2. 각 이메일은 서로 연결되거나 충돌하는 요소를 포함합니다.\n3. 정답이 명확하지 않고 트레이드오프가 존재해야 합니다.\n4. 직급에 맞는 의사결정 범위와 언어 수준을 사용합니다.\n5. 반드시 JSON 형식으로만 응답합니다.",
    "user_template": "다음 조건으로 P2 인바스켓 시나리오를 생성해주세요.\n\n산업: {industry_label} ({industry_context})\n직무군: {jf_label} (주요 업무: {typical_tasks})\n직급: {role_level} (역할: {role_description})\n기업규모: {company_size}\n기업유형: {company_type}\n\n산업 압박 요소: {key_pressures}\n주요 이해관계자: {stakeholders}\n\n생성 조건:\n- 이메일 4개 (긴급도 high 1개, medium 2개, low 1개 혼합)\n- 이메일 간 상충 관계 최소 1쌍\n- AI 활용 가산 포인트 1개 이상\n- 숨겨진 함정(hidden_trap) 각 이메일마다\n\n다음 JSON 스키마를 정확히 따라 응답하세요:\n{output_schema}",
    "output_schema": {
      "scenario_key": "string",
      "world": {
        "company_name": "string",
        "company_type": "string",
        "industry_context": "string",
        "team_context": "string",
        "role_description": "string"
      },
      "trigger_event": "string",
      "emails": [
        {
          "email_id": "E1",
          "from": "string",
          "subject": "string",
          "body": "string (200-400자)",
          "urgency": "high | medium | low",
          "type": "string",
          "stakeholder": "string",
          "hidden_trap": "string"
        }
      ],
      "scoring_criteria": {
        "priority_ranking": {
          "optimal": ["E?", "E?", "E?", "E?"],
          "acceptable": ["E?", "E?", "E?", "E?"],
          "rationale": "string"
        },
        "action_points": [
          {
            "email_id": "E1",
            "optimal_action": "string",
            "acceptable_action": "string",
            "avoid": "string",
            "score_weight": 0.25
          }
        ],
        "ai_use_opportunity": "string",
        "validation_check": "string"
      }
    }
  },

  "hybrid_cache_logic": {
    "_comment": "하이브리드 운영 로직. 프론트 또는 백엔드에서 이 순서로 시나리오를 조회.",
    "lookup_order": [
      {
        "step": 1,
        "key": "{industry}_{jf_group}_{role_level}",
        "source": "DB cache",
        "condition": "n >= 3 (같은 키로 검증된 시나리오 3개 이상)"
      },
      {
        "step": 2,
        "key": "{industry}_{jf_group}",
        "source": "DB cache",
        "condition": "존재하면 랜덤 1개 반환"
      },
      {
        "step": 3,
        "key": "{industry}_{jf_family}",
        "source": "DB cache",
        "condition": "jf_group 없으면 상위 family로 fallback"
      },
      {
        "step": 4,
        "key": "{industry}_only",
        "source": "DB cache",
        "condition": "직무 무관 산업 공통 시나리오"
      },
      {
        "step": 5,
        "key": "realtime_generate",
        "source": "Claude API",
        "condition": "위 4단계 모두 miss. 생성 후 DB에 저장 (검수 후 승인 플래그)."
      }
    ],
    "post_generation": {
      "auto_save": true,
      "requires_review": true,
      "review_flag": "pending_review",
      "approved_flag": "approved",
      "min_approved_before_reuse": 1
    }
  }
