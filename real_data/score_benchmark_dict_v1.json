    },
    "priority_2": {
      "dimensions": [
        "jf_code",
        "role_level_id"
      ],
      "label": "동일 직무+레벨",
      "min_sample": 30
    },
    "priority_3": {
      "dimensions": [
        "family_group_id",
        "role_level_id"
      ],
      "label": "동일 직무군+레벨",
