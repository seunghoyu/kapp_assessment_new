      "label": "전체 집합",
      "note": "표본 부족시 최종 폴백"
    }
  },
  "version_management": {
    "fields_to_version": [
      "taxonomy_version",
      "blueprint_version",
      "item_version",
      "scoring_version",
      "benchmark_version",
      "ai_model_version"
    ],
    "rule": "세션마다 사용된 모든 버전을 context_snapshot에 저장",
    "comparison_rule": "다른 버전 간 점수 직접 비교 불가. 대시보드에서 버전 표시"
